# Mirror Supabase project ONLY — never point this app at production.
# Copy to `.env.local` and fill in keys from the mirror project dashboard (Settings → API).

NEXT_PUBLIC_SUPABASE_URL=https://bzsloubjksvbnosoymwu.supabase.co
# Anon key — required for operator Auth (cookie session via @supabase/ssr). Never use service_role in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Talon.One Integration API (server-only — never NEXT_PUBLIC_)
TALON_ONE_VANTATHRIVE_DEV=
# Optional; defaults to https://medvanta.us-east4.talon.one
TALON_ONE_BASE_URL=
