# Mirror Supabase project ONLY — never point this app at production.
# Copy to `.env.local` and fill in keys from the mirror project dashboard (Settings → API).

NEXT_PUBLIC_SUPABASE_URL=https://bzsloubjksvbnosoymwu.supabase.co
# Anon key — required for operator Auth (cookie session via @supabase/ssr). Never use service_role in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Talon.One Integration API (server-only — never NEXT_PUBLIC_)
TALON_ONE_VANTATHRIVE_DEV=
# App 2 / V2 loyalty campaigns (VP-only)
TALON_ONE_VANTATHRIVE_DEV_2=
# Optional; defaults to https://medvanta.us-east4.talon.one
TALON_ONE_BASE_URL=

# Rewards QA hits local backend (not linked-dev). Defaults to http://127.0.0.1:15440
# when NEXT_PUBLIC_SUPABASE_URL is hosted. Override to reuse current .env:
# LOCAL_BACKEND_URL=$NEXT_PUBLIC_SUPABASE_URL
LOCAL_BACKEND_URL=http://127.0.0.1:15440
# Optional; loopback falls back to supabase-local demo keys
# LOCAL_BACKEND_ANON_KEY=
# LOCAL_BACKEND_SERVICE_ROLE_KEY=
